{
  "Function": {
    "prefix": "fun",
    "body": ["fun ${1:name}(${2:args}):", "\t${0:pass}"],
    "description": "Define a function"
  },
  "Struct": {
    "prefix": "struct",
    "body": ["struct ${1:Name}:", "\t${0:field}"],
    "description": "Define a struct"
  },
  "If": {
    "prefix": "if",
    "body": ["if ${1:condition}:", "\t${0:pass}"],
    "description": "If statement"
  },
  "If / Else": {
    "prefix": "ifelse",
    "body": ["if ${1:condition}:", "\t${2:pass}", "else:", "\t${0:pass}"],
    "description": "If / else statement"
  },
  "For Range": {
    "prefix": "forr",
    "body": ["for ${1:i} in range(${2:n}):", "\t${0:pass}"],
    "description": "Loop over a range of numbers"
  },
  "For In": {
    "prefix": "for",
    "body": ["for ${1:item} in ${2:items}:", "\t${0:pass}"],
    "description": "Loop over a list, text or map"
  },
  "While": {
    "prefix": "while",
    "body": ["while ${1:condition}:", "\t${0:pass}"],
    "description": "While loop"
  },
  "Repeat": {
    "prefix": "repeat",
    "body": ["repeat ${1:5} times:", "\t${0:pass}"],
    "description": "Repeat a block a fixed number of times"
  },
  "Try / Catch": {
    "prefix": "try",
    "body": ["try:", "\t${1:pass}", "catch ${2:err}:", "\t${0:print(err)}"],
    "description": "Handle errors with try / catch"
  },
  "Main": {
    "prefix": "main",
    "body": ["fun main():", "\t${0:print(\"Hello, XE!\")}", "", "main()"],
    "description": "Main function with a call to it"
  }
}
