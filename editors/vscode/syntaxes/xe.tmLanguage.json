{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "XE",
  "scopeName": "source.xe",
  "fileTypes": ["xe"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#number" },
    { "include": "#function-definition" },
    { "include": "#struct-definition" },
    { "include": "#keyword" },
    { "include": "#constant" },
    { "include": "#builtin-call" },
    { "include": "#method-call" },
    { "include": "#function-call" },
    { "include": "#operator" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.xe",
      "match": "(#).*$",
      "captures": {
        "1": { "name": "punctuation.definition.comment.xe" }
      }
    },
    "string": {
      "name": "string.quoted.double.xe",
      "begin": "\"",
      "end": "\"|$",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.xe" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.xe" }
      },
      "patterns": [
        {
          "name": "constant.character.escape.xe",
          "match": "\\\\."
        }
      ]
    },
    "number": {
      "name": "constant.numeric.xe",
      "match": "\\b\\d+(?:\\.\\d+)?\\b"
    },
    "function-definition": {
      "match": "\\b(fun|function|fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.function.xe" },
        "2": { "name": "entity.name.function.xe" }
      }
    },
    "struct-definition": {
      "match": "\\b(struct)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.struct.xe" },
        "2": { "name": "entity.name.type.struct.xe" }
      }
    },
    "keyword": {
      "patterns": [
        {
          "name": "keyword.control.flow.xe",
          "match": "\\b(if|elif|else|while|for|repeat|times|return|break|continue|pass|try|catch)\\b"
        },
        {
          "name": "keyword.control.import.xe",
          "match": "\\b(import|from|as)\\b"
        },
        {
          "name": "storage.modifier.global.xe",
          "match": "\\bglobal\\b"
        },
        {
          "name": "storage.type.function.lambda.xe",
          "match": "\\blambda\\b"
        },
        {
          "name": "keyword.operator.logical.xe",
          "match": "\\b(and|or|not|in)\\b"
        }
      ]
    },
    "constant": {
      "patterns": [
        {
          "name": "constant.language.boolean.xe",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.none.xe",
          "match": "\\bnone\\b"
        }
      ]
    },
    "builtin-call": {
      "match": "(?<![.\\w])(print|input|length|type|convert|append|pop|insert|remove|keys|values|has_key|contains|split|join|range|upper|lower|trim|replace|starts_with|ends_with|find|abs|round|floor|ceil|sqrt|min|max|sum|sort|reverse|copy|random|args|exit|read_file|write_file|append_file|file_exists|error)\\s*(?=\\()",
      "captures": {
        "1": { "name": "support.function.builtin.xe" }
      }
    },
    "method-call": {
      "match": "(?<=\\.)([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.member.xe" }
      }
    },
    "function-call": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.call.xe" }
      }
    },
    "operator": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.compound.xe",
          "match": "\\*\\*=|//=|\\+=|-=|\\*=|/=|%="
        },
        {
          "name": "keyword.operator.comparison.xe",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.arithmetic.xe",
          "match": "\\*\\*|//|\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.assignment.xe",
          "match": "="
        }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.separator.colon.xe", "match": ":" },
        { "name": "punctuation.separator.comma.xe", "match": "," },
        { "name": "punctuation.accessor.dot.xe", "match": "\\." }
      ]
    }
  }
}
