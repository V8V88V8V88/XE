{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["\"", "\""]
  ],
  "folding": {
    "offSide": true
  },
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*|\\d+(?:\\.\\d+)?",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(fun|function|fn|struct|if|elif|else|while|for|repeat|try|catch)\\b.*:\\s*(#.*)?$",
    "decreaseIndentPattern": "^\\s*(elif|else|catch)\\b.*:\\s*(#.*)?$"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*(return|break|continue|pass)\\b.*$",
      "action": { "indent": "outdent" }
    }
  ]
}
